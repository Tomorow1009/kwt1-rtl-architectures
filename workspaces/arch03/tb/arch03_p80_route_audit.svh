// Separate accepted-owner ledger includes CPU traffic through all original ports.
arch03_p80_route_observer #(.DEPTH(`A3DMA.TRANSACTION_DEPTH)) p80_route(
    .clk(a3_mon_clk),
    .rst_n(a3_mon_rst_n),
    .task_arm(a3_task_arm),
    .cpu_accept(`A3MEM.mem_icb_cmd_valid && `A3MEM.mem_icb_cmd_ready),
    .cpu_payload({`A3MEM.mem_icb_cmd_addr,`A3MEM.mem_icb_cmd_read,`A3MEM.mem_icb_cmd_wdata,`A3MEM.mem_icb_cmd_wmask}),
    .cpu_return(`A3MEM.mem_icb_rsp_valid && `A3MEM.mem_icb_rsp_ready),
    .cpu_response({`A3MEM.mem_icb_rsp_err,`A3MEM.mem_icb_rsp_rdata}),
    .dma_accept(`A3MEM.a3_dma_cmd_valid && `A3MEM.a3_dma_cmd_ready),
    .dma_payload({`A3MEM.a3_dma_cmd_addr,`A3MEM.a3_dma_cmd_read,`A3MEM.a3_dma_cmd_wdata,`A3MEM.a3_dma_cmd_wmask}),
    .dma_return(`A3MEM.a3_dma_rsp_valid && `A3MEM.a3_dma_rsp_ready),
    .dma_response({`A3MEM.a3_dma_rsp_err,`A3MEM.a3_dma_rsp_rdata}),
    .root_accept(`A3MEM.a3_bus_cmd_valid && `A3MEM.a3_bus_cmd_ready),
    .root_payload({`A3MEM.a3_bus_cmd_addr,`A3MEM.a3_bus_cmd_read,`A3MEM.a3_bus_cmd_wdata,`A3MEM.a3_bus_cmd_wmask}),
    .root_return(`A3MEM.a3_bus_rsp_valid && `A3MEM.a3_bus_rsp_ready),
    .root_response({`A3MEM.a3_bus_rsp_err,`A3MEM.a3_bus_rsp_rdata}),
    .o4_accept(`A3MEM.a3_cpu_cmd_valid && `A3MEM.a3_cpu_cmd_ready),
    .o4_payload({`A3MEM.a3_cpu_cmd_addr,`A3MEM.a3_cpu_cmd_read,`A3MEM.a3_cpu_cmd_wdata,`A3MEM.a3_cpu_cmd_wmask}),
    .o4_return(`A3MEM.a3_cpu_rsp_valid && `A3MEM.a3_cpu_rsp_ready),
    .o4_response({`A3MEM.a3_cpu_rsp_err,`A3MEM.a3_cpu_rsp_rdata}),
    .mem_accept(`A3MEM.a3_mem_cmd_valid && `A3MEM.a3_mem_cmd_ready),
    .mem_payload({`A3MEM.a3_mem_cmd_addr,`A3MEM.a3_mem_cmd_read,`A3MEM.a3_mem_cmd_wdata,`A3MEM.a3_mem_cmd_wmask}),
    .mem_return(`A3MEM.a3_mem_rsp_valid && `A3MEM.a3_mem_rsp_ready),
    .mem_response({`A3MEM.a3_mem_rsp_err,`A3MEM.a3_mem_rsp_rdata}),
    .src_accept(a3_source_cmd_valid && a3_source_cmd_ready),
    .src_payload({a3_source_cmd_addr,a3_source_cmd_read,a3_source_cmd_wdata,a3_source_cmd_wmask}),
    .src_return(a3_source_rsp_valid && a3_source_rsp_ready),
    .src_response({a3_source_rsp_err,a3_source_rsp_rdata}));
task p80_report_route; begin p80_route.report(a3_encoded_words,12672); end endtask
